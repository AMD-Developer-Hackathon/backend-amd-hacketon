# App
APP_NAME="AMD Smart Product Assistant API"
APP_ENV=local
DEBUG=true
API_PREFIX=/api

# Database
# Use the Supabase PostgreSQL connection string.
# Direct connection example:
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Pooler connection example:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# URL-encode special characters in the password, for example @ becomes %40.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/amd_smart_product_assistant

# AI provider configuration for later stages.
# Local Mac development should use mock.
AI_PROVIDER=mock
MOCK_MODEL=amd-smart-assistant-mock

# Future vLLM OpenAI-compatible endpoint on AMD Developer Cloud.
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODEL=
